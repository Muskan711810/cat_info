# Copy this file to .env and fill in real values. Never commit the real .env.

# Free Postgres: create one at neon.tech or supabase.com, then paste its connection string here
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Any long random string — used to sign login tokens
JWT_SECRET=change-me-to-something-long-and-random

# Comma-separated list of frontend URLs allowed to call this API
CORS_ORIGINS=http://localhost:5173
